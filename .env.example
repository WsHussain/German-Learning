# ── Database ────────────────────────────────────────────────────────────────
# Local via docker-compose: docker compose up -d
DATABASE_URL="postgresql://deutsch:deutsch@localhost:5432/deutsch_coach?schema=public"

# ── Auth.js / NextAuth ──────────────────────────────────────────────────────
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=""
NEXTAUTH_URL="http://localhost:3000"

# ── Content: YouTube Data API (optional) ────────────────────────────────────
# Without this key, the app falls back to curated seed content (see prisma/seed).
# Get a key at https://console.cloud.google.com/apis/credentials (enable "YouTube Data API v3").
YOUTUBE_API_KEY=""
